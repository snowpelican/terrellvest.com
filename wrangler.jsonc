// Cloudflare Workers static site: serves the prebuilt _dist folder as is.
{
  "name": "terrellvest-com",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./_dist",
    "html_handling": "auto-trailing-slash"
  },
  // Lets `wrangler preview` (the deploy command for branches other than master) build a private preview of a branch
  "previews": {}
}
